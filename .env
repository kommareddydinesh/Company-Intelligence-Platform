# Environment Variables Configuration
PROJECT_NAME="Enterprise Company Intelligence Platform"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# FastAPI Backend Configuration
HOST="0.0.0.0"
PORT=8080

# Security & JWT Authentication
JWT_SECRET="super_secret_enterprise_jwt_key_2026_change_in_prod"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 Hours

# PostgreSQL Configuration
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgrespassword"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="company_intel_db"
DATABASE_URL="postgresql+asyncpg://postgres:postgrespassword@localhost:5432/company_intel_db"

# Neo4j Graph Database Configuration
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="neo4jpassword"

# ChromaDB Vector Store Configuration
CHROMADB_HOST="localhost"
CHROMADB_PORT=8000
CHROMADB_COLLECTION_NAME="enterprise_companies"

# Embedding Model
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2" # or BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# LLM Configuration (Local or OpenAI Fallback)
LLM_PROVIDER="openai" # options: openai, ollama, mock
OPENAI_API_KEY="sk-proj-your-openai-api-key-here"
OLLAMA_BASE_URL="http://localhost:11434"
LLM_MODEL_NAME="gpt-4o-mini"
